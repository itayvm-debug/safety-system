{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(gh *)",
      "Bash(vercel *)",
      "Bash(supabase *)",
      "mcp__supabase",
      "mcp__vercel"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production*)",
      "Read(./.env.development*)",
      "Read(./playwright/.auth/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(gh repo delete*)",
      "Bash(vercel remove*)",
      "Bash(vercel rm*)",
      "Bash(vercel project rm*)",
      "Bash(vercel project remove*)",
      "Bash(supabase db reset*)",
      "Bash(supabase projects delete*)"
    ]
  }
}
