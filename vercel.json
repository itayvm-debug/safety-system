{
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)*.md' ':(exclude)docs' ':(exclude)supabase' ':(exclude)tests' ':(exclude)**/__tests__/**' ':(exclude).github'",
  "regions": [
    "hnd1"
  ],
  "crons": [
    {
      "path": "/api/reports/weekly-status",
      "schedule": "0 7 * * 0"
    },
    {
      "path": "/api/reviews/weekly-snapshot-cron",
      "schedule": "0 6 * * 0"
    },
    {
      "path": "/api/reviews/reminder-cron",
      "schedule": "0 6 * * 4"
    },
    {
      "path": "/api/maintenance/daily",
      "schedule": "30 2 * * *"
    }
  ]
}
