# SafeDoc — Example Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# See docs/client-template/VERCEL_SETUP_CHECKLIST_HE.md for setup guide.
#
# This list is derived from actual process.env usage across the codebase.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-safedoc-deployment.vercel.app
# CRITICAL: used to sign session cookies with HMAC-SHA256.
# Generate with: openssl rand -base64 64
SESSION_SECRET=replace-with-64-byte-random-base64-string

# ── Customer Identity ────────────────────────────────────────────────────────
NEXT_PUBLIC_CUSTOMER_NAME=שם החברה בעברית
NEXT_PUBLIC_CUSTOMER_NAME_EN=Company Name in English
NEXT_PUBLIC_CUSTOMER_REG=512345678
NEXT_PUBLIC_CUSTOMER_ADDRESS=רחוב הדוגמה 1, תל אביב
NEXT_PUBLIC_CUSTOMER_PHONE=03-1234567
NEXT_PUBLIC_CUSTOMER_EMAIL=info@example.com
NEXT_PUBLIC_CUSTOMER_SAFETY_EMAIL=safety@example.com

# ── Reports ─────────────────────────────────────────────────────────────────
# Email address that receives weekly safety reports
REPORT_TO_EMAIL=reports@example.com
# Email address used as the "From" field in sent reports
REPORT_FROM_EMAIL=noreply@example.com

# ── Cron (Vercel Cron Jobs) ──────────────────────────────────────────────────
# Used to authenticate Vercel Cron requests to /api/reports/weekly-status
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-hex-secret

# ── Optional — Email (weekly reports via Resend) ─────────────────────────────
# RESEND_API_KEY=re_...

# ── Optional — AI features ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Deprecated / Not Used ────────────────────────────────────────────────────
# COOKIE_SECRET is NOT used for session signing (SESSION_SECRET handles that).
# It was referenced only in lib/csrf.ts as a fallback; SESSION_SECRET is preferred.
# Do NOT set COOKIE_SECRET — SESSION_SECRET is the canonical secret.
