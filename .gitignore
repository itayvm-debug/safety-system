# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
# Playwright runtime auth state — contains session tokens, never commit
/playwright/.auth

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# backup script outputs
db-metadata-*.json
storage-manifest-*.json
safedoc-export-*.zip
backups/

# generated client configs from scripts/create-client-config.ps1
.env.local.new
.env.local.client-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Brand asset source / working files (production assets live in public/branding/)
/SafeDoc LOGO/
